{
  "name": "@aftercare/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./testing": "./test/support.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env scripts/bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:reset:test": "tsx --env-file-if-exists=../../.env scripts/reset-test.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aftercare/contracts": "workspace:*",
    "@aftercare/domain": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
