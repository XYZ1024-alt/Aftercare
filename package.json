{
  "name": "aftercare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:bootstrap": "pnpm --filter @aftercare/storage run db:bootstrap",
    "db:migrate": "pnpm --filter @aftercare/storage run db:migrate development",
    "db:migrate:test": "pnpm --filter @aftercare/storage run db:migrate test",
    "db:reset:test": "pnpm --filter @aftercare/storage run db:reset:test",
    "db:seed": "pnpm --filter @aftercare/storage run db:seed",
    "demo": "pnpm --filter @aftercare/evidence run demo",
    "demo:repair": "pnpm --filter @aftercare/repair run demo",
    "demo:case": "pnpm --filter @aftercare/repair run demo:case",
    "demo:execution": "pnpm --filter @aftercare/execution run demo",
    "demo:autonomous": "pnpm --filter @aftercare/console run demo:autonomous",
    "dev:web": "pnpm --filter @aftercare/web run dev",
    "dev:worker": "pnpm --filter @aftercare/worker run start",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "demo:verify": "pnpm --filter @aftercare/verify run demo",
    "agent": "pnpm --filter @aftercare/agent run cli",
    "demo:agent": "pnpm --filter @aftercare/agent run demo",
    "ops": "pnpm --filter @aftercare/console run ops",
    "test:e2e": "playwright test",
    "eval:compare": "AFTERCARE_EVAL_COMPARE=1 vitest run packages/agent/test/comparison.test.ts",
    "eval:autonomous": "AFTERCARE_EVAL_AUTONOMOUS=1 vitest run packages/console/test/autonomous-eval.test.ts",
    "build:web": "pnpm --filter @aftercare/web run build",
    "start:web": "pnpm --filter @aftercare/web run start"
  },
  "devDependencies": {
    "@aftercare/agent": "workspace:*",
    "@aftercare/console": "workspace:*",
    "@aftercare/repair": "workspace:*",
    "@aftercare/storage": "workspace:*",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
