# Local development only. Copy to .env (git-ignored) and change the passwords.
# No model API key is needed: this stage never calls a model.
AFTERCARE_DB_HOST=127.0.0.1
AFTERCARE_DB_PORT=55432

# Two separate databases in the one local instance. Tests only ever touch the
# test database; the reset additionally requires the disposable marker that
# `pnpm db:bootstrap` puts on it.
AFTERCARE_DEV_DATABASE=aftercare_dev
AFTERCARE_TEST_DATABASE=aftercare_test

# PostgreSQL superuser: used ONLY by the one-off `pnpm db:bootstrap` step.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser

# Owns the schema; used only to run migrations.
AFTERCARE_MIGRATOR_PASSWORD=change-me-local-migrator
# Business SIMULATOR credential (controlled write entry). Not an Agent credential.
AFTERCARE_WRITER_PASSWORD=change-me-local-writer
# Read-only investigation credential.
AFTERCARE_INVESTIGATOR_PASSWORD=change-me-local-investigator
