# Local development only. Copy to .env (git-ignored) and change the passwords.
# Two kinds of secrets live here and are never mixed: the SYSTEM credentials
# of the database roles below, and the MODEL credential further down. A model
# never sees either.
AFTERCARE_DB_HOST=127.0.0.1
AFTERCARE_DB_PORT=55432

# Two separate databases in the one local instance. Tests only ever touch the
# test database; the reset additionally requires the disposable marker that
# `pnpm db:bootstrap` puts on it.
AFTERCARE_DEV_DATABASE=aftercare_dev
AFTERCARE_TEST_DATABASE=aftercare_test

# PostgreSQL superuser: used ONLY by the one-off `pnpm db:bootstrap` step.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser

# Owns the schema; used only to run migrations.
AFTERCARE_MIGRATOR_PASSWORD=change-me-local-migrator
# Business SIMULATOR credential (controlled write entry). Not an Agent credential.
AFTERCARE_WRITER_PASSWORD=change-me-local-writer
# Read-only investigation credential.
AFTERCARE_INVESTIGATOR_PASSWORD=change-me-local-investigator

# Dedicated snapshot management credential: may only call the two snapshot
# management functions. Never used by web/worker, never an Agent credential.
AFTERCARE_SNAPSHOT_MANAGER_PASSWORD=change-me-local-snapshot-manager
# Runtime-side control store credential: cases, coverage manifests,
# certificates and append-only evidence, through restricted functions only.
AFTERCARE_RUNTIME_PASSWORD=change-me-local-runtime
# Authority administration: may only grant/revoke who is allowed to record
# business confirmations. Never used by web/worker/Runtime, never an Agent credential.
AFTERCARE_AUTHORITY_ADMIN_PASSWORD=change-me-local-authority-admin
# TEST ONLY: owner-equivalent role that can connect to the test database and
# nothing else. Integration tests use it to fabricate damaged histories.
AFTERCARE_TEST_ADMIN_PASSWORD=change-me-local-test-admin

# Repair executor credential: may only call the aftercare_execution.* entries.
# Never used by web, never an Agent credential.
AFTERCARE_EXECUTOR_PASSWORD=change-me-local-executor

# Independent verifier credential: may only call the aftercare_verification.* entries
# and read snapshot/branch schemas. Never used by web, never an Agent credential.
AFTERCARE_VERIFIER_PASSWORD=change-me-local-verifier

# Promoter credential (stage 9): may only call aftercare_promotion.promote, which writes a
# sealed, approved repair back to the source through the guarded entry. Never an Agent credential.
AFTERCARE_PROMOTER_PASSWORD=change-me-local-promoter

# ── Stage 7: the Agent ──────────────────────────────────────────────────────
# The service identity model-chosen case commands are issued under. The
# authority admin must grant it investigate_case and manage_case — and nothing
# else: a principal holding any human capability is refused as an agent.
AFTERCARE_AGENT_PRINCIPAL=agent:aftercare-runtime

# MODEL credential: an OpenAI-compatible chat-completions service with function
# tools. Read by the server-side worker only; never stored, logged, shown or
# sent anywhere but the Authorization header of a model request. Leave empty
# to run without a model (scripted tests and the --scripted demo still work).
AFTERCARE_MODEL_BASE_URL=
AFTERCARE_MODEL_API_KEY=
AFTERCARE_MODEL_NAME=
# Optional: per-request timeout (ms), service differences, sampling, prices.
# AFTERCARE_MODEL_TIMEOUT_MS=60000
# AFTERCARE_MODEL_MAX_TOKENS_PARAM=max_tokens        # or max_completion_tokens
# AFTERCARE_MODEL_PARALLEL_TOOL_CALLS=omit           # or disable (sends parallel_tool_calls=false)
# AFTERCARE_MODEL_TEMPERATURE=0
# Cost is reported only with both prices set (per million tokens) AND usage reported by the service.
# AFTERCARE_MODEL_PRICE_INPUT_PER_MTOK=
# AFTERCARE_MODEL_PRICE_OUTPUT_PER_MTOK=
# AFTERCARE_MODEL_PRICE_CURRENCY=USD
# Context window and output limit are read from the public models.dev catalogue
# (one anonymous GET; no credential, no prompt, no business data is sent).
# AFTERCARE_MODELS_DEV_URL=https://models.dev/api.json
# models.dev ids of this model. Without a provider, the catalogue is matched by the host
# of AFTERCARE_MODEL_BASE_URL; the model id defaults to AFTERCARE_MODEL_NAME.
# AFTERCARE_MODEL_CATALOG_PROVIDER=
# AFTERCARE_MODEL_CATALOG_MODEL=

# Set to 1 to run the opt-in live model evaluation (packages/agent/test/live-model.test.ts).
AFTERCARE_LIVE_MODEL_TESTS=
# Set to 1 (pnpm eval:compare sets it) to run the comparison of the two context profiles with the real model.
# AFTERCARE_EVAL_COMPARE=
# AFTERCARE_EVAL_REPETITIONS=1

# ── Stage 8: the operator console, the worker daemon, local operations ──────
# Every variable here is read by SERVER processes only. Nothing is sent to a
# browser; there is no NEXT_PUBLIC_ variable in this project.

# What the console calls itself. The engineering name stays Aftercare.
# AFTERCARE_DISPLAY_NAME=Aftercare Trace
# Which database web, worker and "pnpm ops" work on: development (default) or test.
# AFTERCARE_DATABASE_TARGET=development
# The origin browsers use. State-changing requests from any other Origin are refused.
# AFTERCARE_CONSOLE_ORIGIN=http://127.0.0.1:3100
# 1 when the console is served over HTTPS: the session cookie then carries Secure (and the __Host- prefix).
# AFTERCARE_CONSOLE_SECURE_COOKIES=0
# Origins allowed to embed the console in a frame (space-separated CSP
# frame-ancestors sources). Unset: no site may frame it. The ModelScope Studio
# image sets https://modelscope.cn itself.
# AFTERCARE_CONSOLE_FRAME_ANCESTORS=
# AFTERCARE_SESSION_TTL_SECONDS=28800

# Model mode of the worker. Unset: "live" when AFTERCARE_MODEL_* is configured, otherwise no run is driven.
#   live           the configured model service
#   scripted_test  a rule-driven TEST DOUBLE (packages/agent/src/model/protocol-driver.ts); every page
#                  says so, and its runs are no evidence of a model's ability
# AFTERCARE_MODEL_MODE=

# Local files: artefacts and backups live under <dir>/<target>/. Default: .aftercare/ at the workspace root.
# AFTERCARE_DATA_DIR=

# Deployment quota of one snapshot (defaults: 500 000 rows, 256 MiB).
# AFTERCARE_SNAPSHOT_MAX_TOTAL_ROWS=
# AFTERCARE_SNAPSHOT_MAX_TOTAL_BYTES=

# Retention, in days, per kind. A kind WITHOUT a value is never cleaned. Cleaning is a dry run unless
# applied explicitly by a holder of administer_local (pnpm ops retention --apply, or the admin page).
# AFTERCARE_RETENTION_EVENTS_DAYS=
# AFTERCARE_RETENTION_SNAPSHOTS_DAYS=
# AFTERCARE_RETENTION_BRANCHES_DAYS=
# AFTERCARE_RETENTION_ARTEFACTS_DAYS=
# AFTERCARE_RETENTION_BACKUPS_DAYS=

# Stage 9, autonomy. Both at least 16 characters; secrets: never commit real values.
#   AFTERCARE_INTAKE_SECRET    HMAC key of POST /api/intake (header x-aftercare-signature: sha256=<hex of the raw body>).
#                              Unset: the intake endpoint does not exist.
#   AFTERCARE_DELIVERY_SECRET  HMAC key the autopilot signs its delivery webhooks with. Unset: no webhook is sent.
# AFTERCARE_INTAKE_SECRET=
# AFTERCARE_DELIVERY_SECRET=

# Worker: a stable id (a restarted worker with the same id continues its own lease), lease TTL, poll interval.
# AFTERCARE_WORKER_ID=aftercare-worker-1
# AFTERCARE_WORKER_LEASE_TTL_SECONDS=300
# AFTERCARE_WORKER_POLL_MS=1000

# Used by "pnpm ops account:set" and "pnpm ops demo:init" instead of asking. Leave unset in shared shells.
# AFTERCARE_OPERATOR_PASSWORD=
# AFTERCARE_DEMO_PASSWORD=

# ── Docker (docker compose) ─────────────────────────────────────────────────
# The console listens on 3100 inside the container. These two control what the
# host exposes. Keep the bind on 127.0.0.1 unless people on the LAN must reach it.
# AFTERCARE_WEB_PORT=3100
# AFTERCARE_WEB_BIND=127.0.0.1

# The one-off init container writes the demonstration accounts and business
# activity only on the first start, when no console account exists yet. Set to
# 0 for a structure-only deployment; the superadmin below is still created.
# AFTERCARE_DEMO_INIT=1

# Password of the "superadmin" console account that init creates with every
# capability. Unset: AFTERCARE_DEMO_PASSWORD, otherwise generated once and
# printed in the init logs.
# AFTERCARE_SUPERADMIN_PASSWORD=
